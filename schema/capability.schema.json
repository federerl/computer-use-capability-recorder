          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextExactStrategy",
      "type": "object"
    },
    "TextPresent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_present",
          "default": "text_present",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
