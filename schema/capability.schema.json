              "scoped_role": "#/$defs/ScopedRoleStrategy",
              "text_exact": "#/$defs/TextExactStrategy"
            },
            "propertyName": "by"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RoleNameStrategy"
            },
            {
              "$ref": "#/$defs/ScopedRoleStrategy"
            },
            {
              "$ref": "#/$defs/TextExactStrategy"
            },
            {
              "$ref": "#/$defs/CssStrategy"
            }
          ],
          "title": "Primary"
        },
        "fallbacks": {
          "items": {
            "discriminator": {
              "mapping": {
                "css": "#/$defs/CssStrategy",
                "role_name": "#/$defs/RoleNameStrategy",
                "scoped_role": "#/$defs/ScopedRoleStrategy",
                "text_exact": "#/$defs/TextExactStrategy"
              },
              "propertyName": "by"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoleNameStrategy"
              },
              {
                "$ref": "#/$defs/ScopedRoleStrategy"
              },
              {
                "$ref": "#/$defs/TextExactStrategy"
              },
              {
                "$ref": "#/$defs/CssStrategy"
              }
            ]
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "disambiguation": {
          "$ref": "#/$defs/Disambiguation"
        }
      },
      "required": [
        "primary"
      ],
      "title": "Target",
      "type": "object"
    },
    "TextAbsent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_absent",
          "default": "text_absent",
          "title": "Kind",
          "type": "string"
        },
        "value": {
