{
  "schema_version": "1.0.0",
  "id": "meridian.stop_payment.place",
  "version": "1.2.0",
  "title": "Place stop payment on a check",
  "description": "Signs in to the Meridian CU back office, looks up a member by member number, opens the specified account type, and submits a stop payment for a given check number and reason. Returns the confirmation details.",
  "approval_state": "approved",
  "surface": {
    "kind": "web",
    "engine": "chromium"
  },
  "app_profile": {
    "product": "meridian-backoffice",
    "product_version": "3.2",
    "tenant": "meridian-cu",
    "entry": "${BASE_URL}/login"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "pattern": "^[0-9]{6}$",
      "description": "Member number as printed on the servicing record.",
      "sensitivity": "pii_id",
      "example": "100482"
    },
    {
      "name": "account_kind",
      "type": "string",
      "required": true,
      "enum": [
        "Checking",
        "Savings"
      ],
      "description": "Which of the member's accounts the check was drawn on.",
      "sensitivity": "none",
      "example": "Checking"
    },
    {
      "name": "check_number",
      "type": "string",
      "required": true,
      "pattern": "^[0-9]{1,6}$",
      "description": "Number of the check to stop.",
      "sensitivity": "none",
      "example": "1043"
    },
    {
      "name": "reason",
      "type": "string",
      "required": true,
      "enum": [
        "lost_check",
        "stolen_check",
        "dispute",
        "other"
      ],
      "description": "Why the stop payment is being placed.",
      "sensitivity": "none",
      "example": "lost_check"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "required": true,
      "pattern": "^SP-\\d+$",
      "description": "Confirmation number of the stop payment.",
      "sensitivity": "none"
    },
    {
      "name": "stop_payment_fee",
      "type": "string",
      "required": true,
      "pattern": "^\\d+\\.\\d{2}$",
      "description": "Fee charged for the stop payment.",
      "sensitivity": "none"
    },
    {
      "name": "masked_account_number",
      "type": "string",
      "required": true,
      "pattern": "^\\*{4}\\d{4}$",
      "description": "Masked account number the stop payment was placed on.",
      "sensitivity": "account"
    },
    {
      "name": "check_number_confirmed",
      "type": "string",
      "required": true,
      "pattern": "^\\d+$",
      "description": "Check number the stop payment applies to.",
      "sensitivity": "none"
    },
    {
      "name": "placed_at",
      "type": "string",
      "required": true,
      "description": "Timestamp when the stop payment was placed.",
      "sensitivity": "none"
    }
  ],
  "secrets": [
    {
      "name": "operator_user",
      "ref": "env:BACKOFFICE_USER",
      "used_in_steps": [
        "s2"
      ]
    },
    {
      "name": "operator_password",
      "ref": "env:BACKOFFICE_PASSWORD",
      "used_in_steps": [
        "s3"
      ]
    }
  ],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "url": "${BASE_URL}/login",
      "wait": {
        "until": "settled",
        "scope": {
          "frame": "main"
        },
        "timeout_ms": 8000
      },
      "risk": "safe",
      "note": ""
